# Why Generated   : {{ why_generated }}
# Requirement     : {{ requirement_mapping }}
# How it Exercises:
#   GIVEN {{ given }}
#   WHEN  {{ when }}
#   THEN  {{ then }}
# Coverage        : {{ coverage_contribution }}
# Expected Outcome: {{ expected_outcome }}
# Gaps            : {{ gaps_missing }}
# Meaningfulness  : {{ meaningfulness_check }}
